*__pycache__/

# Local outputs / artifacts (do not commit)
outputs/
deployment/outputs/
backup/
compile_commands.json

# Videos (large artifacts)
video/
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.flv
*.m4v

# Build / IDE / cache artifacts
build/
deployment/build/
.vscode/
**/.cmake/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
**/*.o
**/*.obj
**/*.a
**/*.so
**/*.dylib
**/*.dll

# Training outputs / python packaging
runs/
**/*.egg-info/

# Large model artifacts
*.pt
*.pth
*.whl
*.engine
*.onnx.data

# Docs/binaries often large
*.pdf

# Deployment bundles / models (download locally)
deployment/onnxruntime-*/
deployment/*.onnx
deployment/models/

# Local experiment templates (generated/symlinks)
deployment/pixel_kinds_templates/

# Large modification artifacts
modification/*.engine
modification/*.onnx
modification/*.onnx.data
modification/*openvino_model/
modification/*openvino_model/**

# Office docs / temp locks
*.docx
**/.~lock.*

# Third-party/vendor payloads should be fetched locally.
third_party/

# Generated experiment records are large. Keep lightweight writeup assets and
# manifests needed by the experiment scripts.
record/**
!record/
!record/**/
!record/**/*.md
!record/**/*.tex
!record/**/*.pdf
!record/**/manifest/**/*.json
record/**/figures/**/*.pdf
record/**/bsp_figs/**/*.pdf
record/final3/**

# Local experiment output directories; experiment code lives under tools/.
/experiments/
